{
  "manifest_version": 3,
  "name": "ChatGPT Answer Navigator",
  "description": "在 ChatGPT 对话页面右侧显示实时对话目录，点击目录项可快速跳转到对应回答。",
  "version": "0.2.0",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
